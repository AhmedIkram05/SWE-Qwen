# ── SWE-Qwen Environment Configuration ──────────────────────────────────────
# Data pipeline uses SWE-bench (Hugging Face datasets) as primary source.
# BigQuery augmentation is optional — enable with the `--bigquery` flag.
# See: docs/planning/PHASE-3-DATA-PIPELINE-PLAN.md

# ── GCS bucket for dataset archival (created by Terraform) ──────────────────
DATA_PIPELINE_GCS_BUCKET=<your-gcs-bucket-name>

# ── Modal (GPU execution for training + evaluation) ─────────────────────────
MODAL_TOKEN_ID=<your-modal-token-id>
MODAL_TOKEN_SECRET=<your-modal-token-secret>
# Bearer token the serving endpoint checks on /v1/chat/completions.
MODAL_SERVE_TOKEN=<a-long-random-token>
# Only needed by preflight_serve.py / the serving benchmark.
MODAL_WEB_URL=<your-modal-web-url>
MODAL_WEB_TOKEN=<your-modal-web-token>

# ── Required: W&B API key ───────────────────────────────────────────────────
WANDB_API_KEY=<your-wandb-api-key>

# --- Required: Hugging Face Token ----------
HF_TOKEN=<your-hugging-face-token>

# ── Required: Langfuse credentials ────────────────────────────────────────────
LANGFUSE_SECRET_KEY=<your-langfuse-secret-key>
LANGFUSE_PUBLIC_KEY=<your-langfuse-public-key>
# NB: the host, not a base URL — the SDK reads LANGFUSE_HOST.
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Cost accounting (overrides the GPU rate table in config/observability.yaml) ─
# OBSERVABILITY_RATE_PER_HOUR=2.5

# ── Evaluation ──────────────────────────────────────────────────────────────
# Dataset run id the golden set + tokenized splits resolve from.
EVAL_DATASET_RUN_ID=expanded-repos
# Absolute F2P floor the smoke gate and champion revalidation enforce.
# EVAL_MIN_F2P_THRESHOLD=0.15

# ── Serving (Modal scale-to-zero endpoint) ──────────────────────────────────
# Registry model key to serve; must exist in config/models[.user].yaml.
# SERVING_BASE_MODEL=qwen3-14b
# Modal GPU spec override. SERVING_GPU=A10G:1
# SERVING_STUB=0            # 0 = real vLLM engine, anything else = stub
# SERVING_TELEMETRY_TRACE_SAMPLE_RATE=0.1

# ── Promotion gate ──────────────────────────────────────────────────────────
# Absolute gain a challenger must clear over the champion.
# PROMOTE_MIN_F2P_GAIN=0.05
# Largest tolerated P2P regression, in points.
# PROMOTE_MAX_P2P_REGRESSION=0.02

# ── Google Cloud ────────────────────────────────────────────────────────────
# GCP_PROJECT_ID=<your-gcp-project>
# GCP_REGION=europe-west2
